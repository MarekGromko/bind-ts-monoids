{
    "compilerOptions": {
        "target": "es6",
        "module": "es6",
        "strict": true,
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "allowImportingTsExtensions": true,
        "rewriteRelativeImportExtensions": true,
        "skipLibCheck": true,
        "declaration": true,

        "rootDir": "src",
        "outDir": "dist"
    },
    "include": ["src/**/*.ts"]
}
